#include <iostream>       // Include IO library
class Complex {           // Define class
private:
    double real, imag;       // Data variables
public:
                            // Constructor initializes values
    Complex(double r = 0, double i = 0) : real(r), imag(i) {}
    // Overload + operator
    Complex operator + (const Complex& obj) {
        Complex temp;                 // Temporary object
        temp.real = this->real + obj.real;          // Sum real parts
        temp.imag = this->imag + obj.imag;              // Sum imaginary parts
        return temp;                           // Return final sum
    }
                                              // Display function
    void display() const {
        if (imag >= 0)                       // If positive imaginary
            std::cout << real << " + " << imag << "i" << std::endl;
        else                           // If negative imaginary
            std::cout << real << " - " << -imag << "i" << std::endl;
    }
};
int main() {                       // Main function
    Complex c1(3.5, 2.5);                // Create number 1
    Complex c2(1.2, 4.3);                // Create number 2
    Complex c3 = c1 + c2;                    // Add them together

    std::cout << "Sum: ";            // Print label
    c3.display();                 // Show results
    return 0;                   // End program
}
