#include <iostream>

class Complex {
public:
    int r, i; 
};
int main() {
    Complex c1, c2, sum;

    std::cout << "Enter 1st number (real and imag):\n";
    std::cin >> c1.r >> c1.i;

    std::cout << "Enter 2nd number (real and imag):\n";
    std::cin >> c2.r >> c2.i;

    sum.r = c1.r + c2.r;
    sum.i = c1.i + c2.i;

    std::cout << "Sum: " << sum.r << " + " << sum.i << "i\n";

    return 0;
}

