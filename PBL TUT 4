#include <iostream>
using namespace std;
class Complex {
public:
    int r, i;
};
int main() {
    Complex c1, c2, sum;

    cout << "Enter 1st number (real and imag):\n";
    cin >> c1.r >> c1.i;

    cout << "Enter 2nd number (real and imag):\n";
    cin >> c2.r >> c2.i;

    sum.r = c1.r + c2.r;
    sum.i = c1.i + c2.i;
    cout << "Sum: " << sum.r << " + " << sum.i << "i\n";
    return 0;
}
  
